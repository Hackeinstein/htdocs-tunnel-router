# Internal folders carry their own "Require all denied" (state/, src/, views/, dev/).
# <Directory> blocks are not allowed in .htaccess files, so none are used here.

# Never serve repository metadata, local config or leftovers from this folder
RedirectMatch 404 "/\.(git|remember|claude|playwright-mcp)(/|$)"
<FilesMatch "^(\.git.*|config\.yml|.*\.(yml|yaml|bak|tmp|log|lock|stamp|md|zip))$">
    Require all denied
</FilesMatch>

# ---- speed ------------------------------------------------------------------------------------------------------
# Compress text responses (pages, JSON from the API, CSS, JS): about 70-80% smaller on the wire.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/x-javascript text/javascript application/json image/svg+xml
</IfModule>

# Files in assets/ are referenced with ?v=<modified time>, so they can be cached for a year without ever going stale.
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"
</IfModule>
