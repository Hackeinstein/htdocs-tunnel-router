# Everything the tool writes at runtime (config incl. API token, routes, caches, alerts, trash, versions, locks...)
state/*
!state/.htaccess

# Local cloudflared config for this machine (not part of the tool)
config.yml

# Build tooling (assets/src/node_modules is a temporary symlink made by dev/build_assets.sh)
assets/src/node_modules

# Packaged copies of the project
*.zip

# Tooling / OS / editor
.remember/
.claude/
.playwright-mcp/
.DS_Store
Thumbs.db
.vscode/
*.swp
